<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#05060B" android:fillViewport="true"
    android:overScrollMode="never">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center_horizontal"
        android:paddingStart="22dp" android:paddingEnd="22dp" android:paddingTop="18dp" android:paddingBottom="28dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="S2" android:textColor="#F5F6FA" android:textSize="25sp" android:textStyle="bold"
                android:letterSpacing="0.08"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="PERSONAL ASSISTANT" android:textColor="#9A9CAA" android:textSize="10sp"
                android:letterSpacing="0.14"/>
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="How can I help?" android:textColor="#F7F7FB" android:textSize="27sp"
            android:fontFamily="sans" android:layout_marginTop="28dp" android:layout_marginBottom="2dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Ask me anything" android:textColor="#9294A2" android:textSize="14sp"/>

        <com.s2jarvis.ultra.JarvisOrbView android:id="@+id/jarvisOrb"
            android:layout_width="300dp" android:layout_height="280dp"
            android:layout_marginTop="12dp" android:layout_marginBottom="2dp"/>

        <TextView android:id="@+id/statusText" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="● READY"
            android:textColor="#D4D5DF" android:textSize="11sp" android:letterSpacing="0.12"
            android:gravity="center" android:paddingStart="18dp" android:paddingEnd="18dp"
            android:paddingTop="9dp" android:paddingBottom="9dp"
            android:background="@drawable/pill_status"/>

        <TextView android:id="@+id/answerText" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="96dp"
            android:gravity="center" android:text="Hello! I'm S2. What can I do for you?"
            android:textColor="#F3F3F8" android:textSize="17sp" android:lineSpacingExtra="5dp"
            android:padding="20dp" android:layout_marginTop="24dp" android:background="@drawable/card_surface"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginTop="22dp">
            <EditText android:id="@+id/questionInput" android:layout_width="0dp"
                android:layout_height="54dp" android:layout_weight="1"
                android:hint="Message S2..." android:textColor="#FFFFFF"
                android:textColorHint="#858795" android:paddingStart="17dp" android:paddingEnd="12dp"
                android:singleLine="true" android:imeOptions="actionSend"
                android:background="@drawable/input_surface"/>
            <Button android:id="@+id/askButton" android:layout_width="54dp"
                android:layout_height="54dp" android:text="↑" android:textSize="23sp"
                android:textColor="#FFFFFF" android:background="@drawable/button_primary"
                android:layout_marginStart="9dp" android:minWidth="0dp" android:padding="0dp"/>
        </LinearLayout>

        <Button android:id="@+id/micButton" android:layout_width="match_parent"
            android:layout_height="58dp" android:text="◉   TALK TO S2"
            android:textColor="#FFFFFF" android:textSize="15sp" android:letterSpacing="0.05"
            android:background="@drawable/button_primary" android:layout_marginTop="12dp"/>
        <Button android:id="@+id/wakeButton" android:layout_width="match_parent"
            android:layout_height="52dp" android:text="ENABLE HEY S2"
            android:textColor="#E8E8F0" android:textSize="13sp"
            android:background="@drawable/button_secondary" android:layout_marginTop="9dp"/>
        <Button android:id="@+id/stopButton" android:layout_width="match_parent"
            android:layout_height="48dp" android:text="STOP VOICE"
            android:textColor="#B7B8C4" android:textSize="12sp"
            android:background="@drawable/button_ghost" android:layout_marginTop="4dp"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="PREFERENCES" android:textColor="#9A9CAA" android:textSize="10sp"
            android:textStyle="bold" android:letterSpacing="0.16" android:layout_marginTop="26dp"
            android:layout_marginBottom="9dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp" android:background="@drawable/card_surface">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Voice language" android:textColor="#F0F0F5" android:textSize="14sp"/>
            <Spinner android:id="@+id/voiceLanguage" android:layout_width="match_parent"
                android:layout_height="48dp" android:background="@drawable/input_surface"
                android:popupBackground="#20212A" android:layout_marginTop="8dp"/>
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#30313C" android:layout_marginTop="12dp" android:layout_marginBottom="12dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="AI server connection" android:textColor="#F0F0F5" android:textSize="14sp"/>
            <EditText android:id="@+id/serverUrl" android:layout_width="match_parent"
                android:layout_height="48dp" android:singleLine="true" android:inputType="textUri"
                android:hint="https://your-server/chat" android:textColor="#FFFFFF"
                android:textColorHint="#858795" android:textSize="12sp" android:padding="12dp"
                android:background="@drawable/input_surface" android:layout_marginTop="8dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Quick actions: time • date • YouTube • WhatsApp • camera • maps • calls • search • alarm"
                android:textColor="#9698A5" android:textSize="11sp" android:lineSpacingExtra="3dp"
                android:layout_marginTop="14dp"/>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="S2 JARVIS  •  VOICE ASSISTANT" android:textColor="#666875"
            android:textSize="10sp" android:gravity="center" android:letterSpacing="0.12"
            android:layout_marginTop="22dp"/>
    </LinearLayout>
</ScrollView>
